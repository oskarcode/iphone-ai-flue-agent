{
  "project": "iPhone AI Flue Agent",
  "scenarios": [
    {
      "id": "shortcut-request",
      "title": "One-shot iPhone Shortcut request",
      "subtitle": "Flue dispatches the durable turn; the agent runs Jev before model generation.",
      "meta": {
        "created": "2026-09-20",
        "updated": "2026-09-20",
        "status": "verified from source and live smoke tests"
      },
      "actors": [
        {
          "id": "user",
          "label": "Oskar",
          "zone": "user",
          "sub_caption": "iPhone user"
        },
        {
          "id": "shortcut",
          "label": "iPhone Shortcut",
          "zone": "mobile",
          "sub_caption": "JSON client"
        },
        {
          "id": "worker",
          "label": "Hono Worker",
          "zone": "worker",
          "sub_caption": "src/app.ts"
        },
        {
          "id": "jev",
          "label": "Jev Router",
          "zone": "llm",
          "sub_caption": "typesafe/jev"
        },
        {
          "id": "flue",
          "label": "Flue Runtime",
          "kind": "internal",
          "zone": "server",
          "sub": [
            {
              "id": "agent",
              "label": "IphoneAssistant"
            },
            {
              "id": "store",
              "label": "Durable state"
            }
          ]
        },
        {
          "id": "model",
          "label": "Workers AI",
          "zone": "llm",
          "sub_caption": "GLM-5.2"
        },
        {
          "id": "retrieval",
          "label": "Retrieval",
          "zone": "external",
          "sub": [
            {
              "id": "browser",
              "label": "Browser Run"
            },
            {
              "id": "web",
              "label": "Public web"
            }
          ]
        }
      ],
      "messages": [
        {
          "phase": "INGRESS"
        },
        {
          "from": "user",
          "to": "shortcut",
          "text": "provide request",
          "paths": [
            "shortcut"
          ]
        },
        {
          "from": "shortcut",
          "to": "worker",
          "text": "POST /v1/ask",
          "caption": "JSON { text }",
          "via": "api",
          "paths": [
            "shortcut"
          ],
          "src": "iPhone Shortcut -> src/app.ts",
          "detail": {
            "why": "Keep one stable mobile endpoint for all request types.",
            "sends": "text up to 30,000 chars",
            "auth": "public endpoint",
            "fails": "400 for invalid text; 502 when the agent fails"
          }
        },
        {
          "from": "worker",
          "to": "flue.agent",
          "text": "dispatch turn",
          "caption": "configured message envelope",
          "via": "api",
          "src": "runAgent() -> agent.dispatch()",
          "detail": {
            "why": "Run the turn in a durable conversation keyed by ID.",
            "sends": "private config + visible prompt"
          }
        },
        {
          "phase": "ROUTE"
        },
        {
          "from": "flue.agent",
          "to": "jev",
          "text": "classify request",
          "caption": "AI binding + gateway",
          "via": "api",
          "src": "useAgentStart() -> classifyWithJev()",
          "detail": {
            "why": "Choose one deterministic execution path before generation.",
            "sends": "mode + prompt + context",
            "fails": "agent falls back to a local safe route"
          }
        },
        {
          "from": "jev",
          "to": "flue.agent",
          "text": "route choice",
          "caption": "direct, URL, search, ask",
          "kind": "ret"
        },
        {
          "phase": "EXECUTE"
        },
        {
          "from": "flue.agent",
          "to": "model",
          "text": "generate answer",
          "caption": "GLM-5.2 through AI Gateway",
          "via": "api",
          "src": "IphoneAssistant() -> useModel()"
        },
        {
          "from": "model",
          "to": "flue.agent",
          "text": "tool request",
          "caption": "web_research route",
          "kind": "ret"
        },
        {
          "from": "flue.agent",
          "to": "retrieval.browser",
          "text": "read page",
          "caption": "Browser Run Markdown",
          "via": "api",
          "src": "webResearch.run() -> BROWSER.quickAction()",
          "detail": {
            "why": "Ground URL answers in rendered page content.",
            "sends": "validated public URL",
            "fails": "tool error when Browser Run has no readable Markdown"
          }
        },
        {
          "from": "flue.agent",
          "to": "retrieval.web",
          "text": "search web",
          "caption": "DuckDuckGo, then Wikipedia",
          "via": "api",
          "src": "webResearch.run()",
          "detail": {
            "why": "Ground current-information answers in public results.",
            "sends": "query up to 500 chars",
            "fails": "Wikipedia is used after a DuckDuckGo failure"
          }
        },
        {
          "from": "retrieval.browser",
          "to": "flue.agent",
          "text": "bounded Markdown",
          "caption": "maximum 16,000 characters",
          "kind": "ret"
        },
        {
          "from": "retrieval.web",
          "to": "flue.agent",
          "text": "search results",
          "caption": "maximum five results",
          "kind": "ret"
        },
        {
          "from": "model",
          "to": "flue.agent",
          "text": "final answer",
          "caption": "text + usage metadata",
          "kind": "ret"
        },
        {
          "phase": "RETURN"
        },
        {
          "from": "flue.agent",
          "to": "worker",
          "text": "completed turn",
          "kind": "ret",
          "src": "agent.read() -> runAgent()"
        },
        {
          "from": "worker",
          "to": "shortcut",
          "text": "JSON answer",
          "caption": "answer + selected route",
          "kind": "ret",
          "via": "api"
        },
        {
          "from": "shortcut",
          "to": "user",
          "text": "show result",
          "kind": "ret"
        }
      ],
      "fragments": [
        {
          "kind": "opt",
          "label": "route requires external evidence",
          "range": [
            7,
            11
          ]
        }
      ]
    },
    {
      "id": "browser-handoff",
      "title": "Shortcut handoff and streaming chat",
      "subtitle": "KV provides best-effort one-time transfer; the browser streams one durable conversation.",
      "meta": {
        "created": "2026-09-20",
        "updated": "2026-09-20",
        "status": "verified from source and live smoke tests"
      },
      "actors": [
        {
          "id": "user",
          "label": "Oskar",
          "zone": "user",
          "sub_caption": "iPhone user"
        },
        {
          "id": "shortcut",
          "label": "iPhone Shortcut",
          "zone": "mobile",
          "sub_caption": "handoff client"
        },
        {
          "id": "browser",
          "label": "Chat UI",
          "zone": "frontend",
          "sub_caption": "src/chat-page.ts"
        },
        {
          "id": "worker",
          "label": "Hono Worker",
          "zone": "worker",
          "sub_caption": "src/app.ts"
        },
        {
          "id": "kv",
          "label": "Workers KV",
          "zone": "datastore",
          "sub_caption": "CHAT_SESSIONS"
        },
        {
          "id": "jev",
          "label": "Jev Router",
          "zone": "llm",
          "sub_caption": "typesafe/jev"
        },
        {
          "id": "flue",
          "label": "Flue + Workers AI",
          "kind": "internal",
          "zone": "server",
          "sub": [
            {
              "id": "agent",
              "label": "Durable agent"
            },
            {
              "id": "model",
              "label": "GLM-5.2"
            }
          ]
        }
      ],
      "messages": [
        {
          "phase": "HANDOFF"
        },
        {
          "from": "user",
          "to": "shortcut",
          "text": "share selected text",
          "paths": [
            "handoff"
          ]
        },
        {
          "from": "shortcut",
          "to": "worker",
          "text": "POST /handoff",
          "caption": "JSON { text }",
          "via": "api",
          "paths": [
            "handoff"
          ],
          "src": "iPhone Shortcut -> createChatSession()"
        },
        {
          "from": "worker",
          "to": "kv",
          "text": "write handoff",
          "caption": "random ID, ten-minute TTL",
          "via": "io",
          "src": "createChatSession() -> CHAT_SESSIONS.put()",
          "detail": {
            "why": "Move selected text without exposing it in the browser URL.",
            "effects": "creates one expiring KV value",
            "ordering": "before chat URL return"
          }
        },
        {
          "from": "worker",
          "to": "shortcut",
          "text": "chat URL",
          "caption": "?session=<random ID>",
          "kind": "ret",
          "via": "api"
        },
        {
          "from": "shortcut",
          "to": "browser",
          "text": "open chat URL",
          "via": "api"
        },
        {
          "phase": "CONSUME"
        },
        {
          "from": "browser",
          "to": "worker",
          "text": "GET /chat",
          "via": "api",
          "src": "browser -> renderChatPage()"
        },
        {
          "from": "worker",
          "to": "browser",
          "text": "chat HTML",
          "kind": "ret",
          "via": "api"
        },
        {
          "from": "browser",
          "to": "worker",
          "text": "GET handoff text",
          "caption": "/chat/session/:id",
          "via": "api",
          "src": "loadSession() -> GET /chat/session/:id"
        },
        {
          "from": "worker",
          "to": "kv",
          "text": "read handoff",
          "via": "io",
          "src": "CHAT_SESSIONS.get()"
        },
        {
          "from": "kv",
          "to": "worker",
          "text": "selected text",
          "kind": "ret",
          "via": "io"
        },
        {
          "from": "worker",
          "to": "kv",
          "text": "delete handoff",
          "caption": "best-effort one-time use",
          "via": "io",
          "src": "CHAT_SESSIONS.delete()",
          "detail": {
            "why": "Reduce accidental reuse after the browser receives the text.",
            "effects": "deletes the KV key",
            "fails": "get/delete is not atomic under concurrent reads"
          }
        },
        {
          "from": "worker",
          "to": "browser",
          "text": "selected text",
          "kind": "ret",
          "via": "api"
        },
        {
          "phase": "STREAM"
        },
        {
          "from": "browser",
          "to": "worker",
          "text": "POST /chat/stream",
          "caption": "conversation ID + history",
          "via": "api",
          "paths": [
            "stream"
          ],
          "src": "sendMessage() -> POST /chat/stream",
          "detail": {
            "why": "Start one live answer while retaining follow-up context.",
            "sends": "up to 20 messages",
            "fails": "400 invalid history; SSE error on agent failure"
          }
        },
        {
          "from": "worker",
          "to": "jev",
          "text": "classify request",
          "caption": "sent before agent dispatch",
          "via": "api"
        },
        {
          "from": "jev",
          "to": "worker",
          "text": "route choice",
          "kind": "ret"
        },
        {
          "from": "worker",
          "to": "flue.agent",
          "text": "dispatch turn",
          "caption": "conversation ID reuses durable state",
          "via": "api",
          "src": "agent.dispatch()"
        },
        {
          "from": "flue.agent",
          "to": "flue.model",
          "text": "generate response",
          "via": "api"
        },
        {
          "from": "flue.model",
          "to": "flue.agent",
          "text": "answer events",
          "caption": "tokens, tools, metadata",
          "kind": "ret"
        },
        {
          "from": "flue.agent",
          "to": "worker",
          "text": "runtime events",
          "caption": "projected to safe public events",
          "kind": "async",
          "src": "agent.read(onEvent) -> projectConversationChunk()"
        },
        {
          "from": "worker",
          "to": "browser",
          "text": "emit SSE events",
          "caption": "classification, tools, tokens, done",
          "kind": "async",
          "via": "api",
          "src": "send() -> consumeEvents()"
        },
        {
          "self": "browser",
          "text": "render live answer",
          "caption": "DOM APIs only; no innerHTML"
        }
      ]
    }
  ],
  "provenance": {
    "git_sha": "a6bf43d243dd5955e4a40a95931be238d4509f4b"
  }
}
