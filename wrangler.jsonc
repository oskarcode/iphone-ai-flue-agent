{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iphone-ai-flue-agent",
  // Production ingress is the Access-protected custom domain, not alternate workers.dev URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "iphoneai.oskarcode.com",
      "custom_domain": true
    }
  ],
  // Cloudflare Web Search requires the current Workers runtime API.
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Non-secret model and gateway selectors are visible to the Worker through process.env.
  "vars": {
    "MODEL": "cloudflare/@cf/zai-org/glm-5.2",
    "AI_GATEWAY_ID": "iphone-flue-shortcut",
    "JEV_MODEL": "typesafe/jev",
    "JEV_SKIP_CACHE": "true"
  },
  // Local development uses the account's real Workers AI, Web Search, and AI Gateway services.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // KV stores ten-minute handoffs plus one-hour learning records; Flue conversation state stays in Durable Objects.
  "durable_objects": {
    "bindings": [
      { "name": "LEARNING_ARCHIVE", "class_name": "LearningArchive" }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_SESSIONS",
      "id": "8bfe929b07e5431fb15a0e185c4d3054"
    }
  ],
  // Each immutable migration introduces one generated SQLite-backed Flue agent class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueIphoneAssistantAgent"]
    },
    {
      "tag": "v2-github-learning",
      "new_sqlite_classes": ["FlueGithubLearningAgent"]
    },
    {
      "tag": "v3-learning-archive",
      "new_sqlite_classes": ["LearningArchive"]
    }
  ],
  // Full sampling is appropriate for this low-volume demo and aids handoff debugging.
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true }
  }
}
