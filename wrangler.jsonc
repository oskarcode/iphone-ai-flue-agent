{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iphone-ai-flue-agent",
  "main": "src/cloudflare.ts",
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "run_worker_first": true },
  // Production ingress is the Access-protected custom domain, not alternate workers.dev URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "iphoneai.oskarcode.com",
      "custom_domain": true
    }
  ],
  // Cloudflare Web Search requires the current Workers runtime API.
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Non-secret model and gateway selectors are visible to the Worker through process.env.
  "vars": {
    "MODEL": "cloudflare/@cf/zai-org/glm-5.2",
    "AI_GATEWAY_ID": "iphone-flue-shortcut",
    "JEV_MODEL": "typesafe/jev",
    "JEV_SKIP_CACHE": "true",
    "ACCESS_ISSUER": "https://oskarman.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "6b76b37f8cf201250eb5cf40e6fcf4b021dd6b5a161481ab599818bee439687a,9ccb2bc95cd828b77a69fe25bf1d16c84b6e8d681461e223bac7c3442d89dd77"
  },
  // Local development uses the account's real Workers AI, Browser Run, and AI Gateway services.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  // Preserve the Shortcut handoff namespace. New learning state lives in Pi SQLite DOs.
  "durable_objects": {
    "bindings": [
      { "name": "LEARNING_ARCHIVE", "class_name": "LearningArchive" },
      { "name": "FLUE_GITHUB_LEARNING_AGENT", "class_name": "FlueGithubLearningAgent" },
      { "name": "FLUE_IPHONE_ASSISTANT_AGENT", "class_name": "FlueIphoneAssistantAgent" },
      { "name": "LEARNING_SESSIONS", "class_name": "LearningSession" },
      { "name": "LEARNING_LIBRARY", "class_name": "LearningLibrary" }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_SESSIONS",
      "id": "8bfe929b07e5431fb15a0e185c4d3054"
    }
  ],
  // Immutable history: retain the original namespaces, then add Pi-backed session/library classes.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueIphoneAssistantAgent"]
    },
    {
      "tag": "v2-github-learning",
      "new_sqlite_classes": ["FlueGithubLearningAgent"]
    },
    {
      "tag": "v3-learning-archive",
      "new_sqlite_classes": ["LearningArchive"]
    },
    {
      "tag": "v4-pi-learning",
      "new_sqlite_classes": ["LearningSession", "LearningLibrary"]
    }
  ],
  // Full sampling is appropriate for this low-volume demo and aids handoff debugging.
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true }
  }
}
